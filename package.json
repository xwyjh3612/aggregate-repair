{
  "name": "magpie-aggregate-repair",
  "version": "0.4.5",
  "description": "修复Codex切换渠道 400 报错，保留聊天内容。适用于 Codex 等 Responses 客户端",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xwyjh3612/aggregate-repair.git"
  },
  "homepage": "https://github.com/xwyjh3612/aggregate-repair#readme",
  "bugs": {
    "url": "https://github.com/xwyjh3612/aggregate-repair/issues"
  },
  "type": "module",
  "files": [
    "middleware.mjs",
    "install.cmd",
    "install.ps1",
    "一键安装.cmd",
    "install-magpie-plugin.ps1",
    "page/index.html",
    "page/app.js",
    "page/style.css",
    "page/icon.svg",
    "README.md",
    "LICENSE",
    "examples/options.json"
  ],
  "scripts": {
    "check": "node --check middleware.mjs && node --check page/app.js",
    "test": "node --test test/middleware.test.mjs test/installer.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "middleware",
    "responses",
    "channel-switch",
    "azure-openai",
    "codex",
    "openai-responses",
    "responses-api",
    "responses-400",
    "session-repair",
    "provider-switch",
    "resource-id",
    "渠道切换",
    "渠道切换修复",
    "会话修复",
    "400修复"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "magpie": {
    "name": "渠道切换修复 · Responses 400",
    "summary": {
      "en": "Fixes Codex 400 errors after switching channels while preserving chat content. Supports Codex and other Responses clients.",
      "zh": "修复Codex切换渠道 400 报错，保留聊天内容。适用于 Codex 等 Responses 客户端",
      "zh-TW": "修復Codex切換渠道 400 錯誤，保留聊天內容。適用於 Codex 等 Responses 用戶端"
    },
    "icon": "https://raw.githubusercontent.com/xwyjh3612/aggregate-repair/main/page/icon.svg",
    "middleware": "./middleware.mjs",
    "page": {
      "title": "Channel Switch Repair · Responses 400",
      "titles": {
        "zh": "渠道切换修复 · Responses 400",
        "zh-TW": "渠道切換修復 · Responses 400"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "options": {
      "middleware": {
        "enabled": true,
        "providers": [
          "*"
        ],
        "models": [],
        "mode": "safe",
        "dropItemReferences": false,
        "stripPreviousResponseId": false,
        "stripConversation": false,
        "rotateSessionOnChange": true
      }
    },
    "permissions": [
      "providers:list"
    ]
  }
}
